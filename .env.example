# Copy to .env (git-ignored); read by docker compose.
PORT=8080
COOK_ADMIN_USER=admin
COOK_ADMIN_PASSWORD=change-me
COOK_DEFAULT_COUNTRY=US
COOK_LOG_FORMAT=json
# S3 image storage (MinIO service in compose). Change the credentials!
MINIO_ROOT_USER=cookcompass
MINIO_ROOT_PASSWORD=cookcompass-secret
COOK_S3_BUCKET=cookcompass
# Machine-translation drafts (docker compose --profile translate); empty disables.
COOK_TRANSLATE_URL=
