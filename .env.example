# `make init` turns this into .env (git-ignored) with fresh secrets; docker compose reads .env.
PORT=8080
COOK_ADMIN_USER=admin
# Secrets are generated by `make init` (leave them empty here).
COOK_ADMIN_PASSWORD=
COOK_DEFAULT_COUNTRY=US
COOK_LOG_FORMAT=json
# S3 image storage (MinIO service in compose).
MINIO_ROOT_USER=cookcompass
MINIO_ROOT_PASSWORD=
COOK_S3_BUCKET=cookcompass
# Machine-translation drafts (docker compose --profile translate); empty disables.
COOK_TRANSLATE_URL=
